"Cafes lost to missing values"),
Result = c(m3, sum(x == 0), N - n3)), "A3_checks")
fig <- ggplot(data.frame(x = x), aes(x)) + geom_histogram(binwidth = 5, fill = "grey75", colour = "white") +
annotate("rect", xmin = ci3[1], xmax = ci3[2], ymin = -Inf, ymax = Inf, alpha = .25, fill = "blue") +
geom_vline(xintercept = est3, colour = "blue") + geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Flat white minus cappuccino (CZK)", y = "Number of cafes")
save_fig(fig, "A3_figure")
add_sum("A3", m3, paste(f1(est3), "CZK"), ci_str(ci3[1], ci3[2], f1), es3, stat3, pfmt(p3), n3, N - n3)
# ============================================================
# A4  More groups: does the cappuccino price differ by cafe type?
# H0: mean cappuccino price equal in all three types   H1: at least one differs (two-tailed)
# ============================================================
cat("\n\n=========== A4 ===========\n")
d4 <- d[!is.na(d$cappuccino) & !is.na(d$cafe_type_f), ]; d4$g <- droplevels(d4$cafe_type_f)
x <- d4$cappuccino; g <- d4$g
par4 <- is_param(VN$cap, levels(g)); lev4 <- levene_p(x, g)
gc <- group_ci(x, g)
if (par4) {
wo <- oneway.test(x ~ g, var.equal = FALSE)            # Welch F
stat4 <- paste0("$F(", f2(wo$parameter[1]), ", ", f2(wo$parameter[2]), ")=", f2(wo$statistic), "$")
p4 <- wo$p.value; m4 <- "Welch ANOVA + Games-Howell"
ph <- games_howell(x, g)
PH <- data.frame(Pair = ph$pair, `Difference (CZK)` = f1(ph$diff), `95% CI` = ci_str(ph$lo, ph$hi, f1),
`Adj. p` = pplain(ph$p_adj), check.names = FALSE)
} else {
kw <- kruskal.test(x ~ g)
stat4 <- paste0("$H(", kw$parameter, ")=", f2(kw$statistic), "$"); p4 <- kw$p.value
m4 <- "Kruskal-Wallis + Dunn (Holm)"
ph <- dunn_holm(x, g)
PH <- data.frame(Pair = ph$pair, `Median difference (CZK)` = f1(ph$diff_median),
`Adj. p` = pplain(ph$p_adj), check.names = FALSE)
}
A4 <- rbind(data.frame(Group = gc$group, n = as.character(gc$n), `Mean (CZK)` = f1(gc$mean),
`95% CI` = ci_str(gc$lo, gc$hi, f1), Test = "", p = "", check.names = FALSE),
data.frame(Group = "Omnibus test", n = as.character(nrow(d4)), `Mean (CZK)` = "",
`95% CI` = "", Test = stat4, p = pfmt(p4), check.names = FALSE))
sh(A4); write_tex(A4, "A4_table"); cat("\nPost hoc:\n"); sh(PH); write_tex(PH, "A4_posthoc")
write_tex(data.frame(Check = c("Method chosen", "Levene test, equal variances", "Smallest group size",
"Cafes lost to missing values"),
Result = c(m4, paste0("p = ", pplain(lev4), " (Welch/rank test does not assume equal variances)"),
min(table(g)), N - nrow(d4))), "A4_checks")
fig <- ggplot(d4, aes(g, cappuccino)) + geom_jitter(width = .12, alpha = .4, colour = "grey30") +
geom_pointrange(data = gc, aes(group, mean, ymin = lo, ymax = hi), colour = "red", inherit.aes = FALSE) +
labs(x = "Cafe type", y = "Cappuccino price (CZK)")
save_fig(fig, "A4_figure")
add_sum("A4", m4, paste0("Means ", paste(f1(gc$mean), collapse = " / "), " CZK"), "see A4 table", "--",
stat4, pfmt(p4), nrow(d4), N - nrow(d4))
# ============================================================
# A5  Two categorical: is a flat white more likely to be above the median in Prague 1?
# H0: share above median equal in Prague 1 and elsewhere
# H1: share is higher in Prague 1 (one-tailed; difference = Prague 1 minus elsewhere)
# ============================================================
cat("\n\n=========== A5 ===========\n")
d5 <- d[!is.na(d$prague1_f) & !is.na(d$above_med_flatwhite), ]
d5$above_f <- factor(ifelse(d5$above_med_flatwhite == 1, "Above median", "At or below median"),
levels = c("Above median", "At or below median"))
tab5 <- table(d5$prague1_f, d5$above_f); N5 <- sum(tab5)
cat("Median flat white used:", median(d$flatwhite, na.rm = TRUE), "CZK\n"); print(tab5)
ct5 <- chisq.test(tab5, correct = FALSE); min_exp <- min(ct5$expected)
a <- tab5[1, 1]; n_a <- sum(tab5[1, ]); b <- tab5[2, 1]; n_b <- sum(tab5[2, ])
pp <- 100 * (a / n_a - b / n_b)
pt2 <- prop.test(c(a, b), c(n_a, n_b), correct = FALSE)               # two-sided CI for the difference
pt1 <- prop.test(c(a, b), c(n_a, n_b), alternative = "greater", correct = FALSE)
V5 <- sqrt(unname(ct5$statistic) / N5)
use_fisher <- min_exp < 5
if (use_fisher) {
ft <- fisher.test(tab5, alternative = "greater"); p5 <- ft$p.value
stat5 <- paste0("Fisher OR=", f2(ft$estimate)); m5 <- "Fisher exact test"
} else {
p5 <- pt1$p.value; stat5 <- paste0("$\\chi^2(1, N=", N5, ")=", f2(ct5$statistic), "$")
m5 <- "Chi-square test (one-tailed p via z-test)"
}
pc <- function(k, n) paste0(k, " (", f1(100 * k / n), "%)")
A5 <- rbind(
data.frame(Group = "Prague 1", n = n_a, `Above median` = pc(a, n_a), `Difference (pp)` = "", `95% CI` = "",
Test = "", `Cramer V` = "", p = "", check.names = FALSE),
data.frame(Group = "Elsewhere", n = n_b, `Above median` = pc(b, n_b), `Difference (pp)` = "", `95% CI` = "",
Test = "", `Cramer V` = "", p = "", check.names = FALSE),
data.frame(Group = "Prague 1 minus elsewhere", n = N5, `Above median` = "", `Difference (pp)` = f1(pp),
`95% CI` = ci_str(100 * pt2$conf.int[1], 100 * pt2$conf.int[2], f1),
Test = stat5, `Cramer V` = f2(V5), p = paste(pfmt(p5), "(one-tailed)"), check.names = FALSE))
sh(A5); write_tex(A5, "A5_table")
cells <- expand.grid(Group = rownames(tab5), Price = colnames(tab5))
write_tex(data.frame(Group = cells$Group, `Flat white price` = cells$Price, Observed = as.vector(tab5),
Expected = f2(as.vector(ct5$expected)), `Std. residual` = f2(as.vector(ct5$stdres)),
check.names = FALSE), "A5_checks")
cat("Smallest expected count:", min_exp, "->", m5, "\n")
ci_g <- t(sapply(1:2, function(i) prop.test(tab5[i, 1], sum(tab5[i, ]), correct = FALSE)$conf.int))
gdf <- data.frame(group = rownames(tab5), share = 100 * c(a / n_a, b / n_b),
lo = 100 * ci_g[, 1], hi = 100 * ci_g[, 2])
fig <- ggplot(gdf, aes(factor(group, levels = c("Prague 1", "Elsewhere")), share)) +
geom_col(fill = "grey75", width = .55) + geom_errorbar(aes(ymin = lo, ymax = hi), width = .15, colour = "red") +
labs(x = NULL, y = "Cafes with flat white above the median (%)")
save_fig(fig, "A5_figure")
add_sum("A5", m5, paste(f1(pp), "pp"), ci_str(100 * pt2$conf.int[1], 100 * pt2$conf.int[2], f1),
paste0("$V=", f2(V5), "$"), stat5, pfmt(p5), N5, N - N5)
# ============================================================
# A6  Correlation: cappuccino price and Adjusted Rating
# H0: no correlation (rho = 0)   H1: correlation differs from 0 (two-tailed)
# ============================================================
cat("\n\n=========== A6 ===========\n")
d6 <- d[!is.na(d$cappuccino) & !is.na(d$adj_rating), ]; x <- d6$cappuccino; y <- d6$adj_rating; n6 <- nrow(d6)
par6 <- is_param(VN$cap, G_ALL) && is_param(VN$adj, G_ALL)
if (par6) {
ct6 <- cor.test(x, y); r6 <- unname(ct6$estimate); ci6 <- ct6$conf.int; p6 <- ct6$p.value
stat6 <- paste0("$t(", ct6$parameter, ")=", f2(ct6$statistic), "$"); m6 <- "Pearson r"; sym <- "r"
} else {
ct6 <- cor.test(x, y, method = "spearman", exact = FALSE); r6 <- unname(ct6$estimate)
set.seed(2026)
bs <- replicate(5000, { i <- sample.int(n6, n6, replace = TRUE); cor(x[i], y[i], method = "spearman") })
ci6 <- quantile(bs, c(.025, .975), names = FALSE, na.rm = TRUE); p6 <- ct6$p.value
stat6 <- paste0("$S=", f2(ct6$statistic), "$"); m6 <- "Spearman rho (bootstrap CI)"; sym <- "\\rho"
}
A6 <- data.frame(Coefficient = paste0("$", sym, "=", sub("^(-?)0", "\\1", f2(r6)), "$"),
`95% CI` = ci_str(ci6[1], ci6[2]), `Shared variance` = paste0(f1(100 * r6^2), "%"),
Test = stat6, p = pfmt(p6), n = n6, check.names = FALSE)
sh(A6); write_tex(A6, "A6_table")
write_tex(data.frame(Check = c("Method chosen", "Cafes lost to missing values"), Result = c(m6, N - n6)), "A6_checks")
fig <- ggplot(d6, aes(adj_rating, cappuccino)) + geom_point(alpha = .6) +
geom_smooth(method = "lm", formula = y ~ x, colour = "red", fill = "red", alpha = .15) +
labs(x = "Adjusted Rating (points)", y = "Cappuccino price (CZK)")
save_fig(fig, "A6_figure")
add_sum("A6", m6, paste0("$", sym, "=", sub("^(-?)0", "\\1", f2(r6)), "$"), ci_str(ci6[1], ci6[2]),
paste0("$r^2=", sub("^0", "", f2(r6^2)), "$"), stat6, pfmt(p6), n6, N - n6)
# ============================================================
# A7  Simple regression: cappuccino price on Adjusted Rating
# H0: slope = 0   H1: slope differs from 0 (two-tailed)
# ============================================================
cat("\n\n=========== A7 ===========\n")
m7 <- lm(cappuccino ~ adj_rating, data = d6)
bp7 <- lmtest::bptest(m7)$p.value; rob7 <- bp7 < .05
vc7 <- if (rob7) sandwich::vcovHC(m7, type = "HC3") else vcov(m7)
rt7 <- reg_table(m7, vc7); sh(rt7$tab); write_tex(rt7$tab, "A7_table")
sw7 <- shapiro.test(resid(m7))$p.value; cd7 <- inf_cooks(m7)
cat("Breusch-Pagan p =", bp7, "| robust SE:", rob7, "| Shapiro residuals p =", sw7,
"| influential (Cook's D > 4/n):", cd7, "\n")
write_tex(data.frame(Check = c("Breusch-Pagan (constant variance)", "Standard errors", "Shapiro-Wilk on residuals",
"Influential cafes (Cook's D > 4/n)", "Cafes lost to missing values"),
Result = c(paste0("p = ", pplain(bp7)), if (rob7) "HC3 robust" else "classical", paste0("p = ", pplain(sw7)),
if (length(cd7)) paste(cd7, collapse = ", ") else "none", N - n6)), "A7_checks")
save_diag(m7, "A7_diag")
b7 <- rt7$est["adj_rating"]; s7 <- paste0("$t(", rt7$df, ")=", f2(b7 / rt7$se["adj_rating"]), "$")
fig <- ggplot(d6, aes(adj_rating, cappuccino)) + geom_point(alpha = .6) +
geom_smooth(method = "lm", formula = y ~ x, colour = "red", fill = "red", alpha = .15) +
labs(x = "Adjusted Rating (points)", y = "Cappuccino price (CZK)")
save_fig(fig, "A7_figure")
add_sum("A7", paste0("OLS", if (rob7) " (HC3 SE)" else ""), paste(f1(b7), "CZK per rating point"),
ci_str(rt7$lo["adj_rating"], rt7$hi["adj_rating"], f1),
paste0("$R^2=", sub("^0", "", f2(summary(m7)$r.squared)), "$"), s7, pfmt(rt7$p["adj_rating"]), n6, N - n6)
# ============================================================
# A8  Multiple regression: does the link hold after controlling for espresso price?
# H0: slope of Adjusted Rating = 0 given espresso price   H1: differs from 0 (two-tailed)
# ============================================================
cat("\n\n=========== A8 ===========\n")
d8 <- d[!is.na(d$cappuccino) & !is.na(d$adj_rating) & !is.na(d$espresso), ]; n8 <- nrow(d8)
m8a <- lm(cappuccino ~ adj_rating, data = d8)                  # same cafes as the full model
m8b <- lm(cappuccino ~ adj_rating + espresso, data = d8)
bpa <- lmtest::bptest(m8a)$p.value; bpb <- lmtest::bptest(m8b)$p.value
rta <- reg_table(m8a, if (bpa < .05) sandwich::vcovHC(m8a, type = "HC3") else vcov(m8a))
rtb <- reg_table(m8b, if (bpb < .05) sandwich::vcovHC(m8b, type = "HC3") else vcov(m8b))
sh(rtb$tab); write_tex(rtb$tab, "A8_table"); write_tex(rta$tab, "A8_simple_table")
vif8 <- 1 / (1 - summary(lm(adj_rating ~ espresso, data = d8))$r.squared)
sw8 <- shapiro.test(resid(m8b))$p.value; cd8 <- inf_cooks(m8b)
before <- rta$est["adj_rating"]; after <- rtb$est["adj_rating"]
cat("Slope before:", before, " after:", after, " remaining:", 100 * after / before, "%\n")
write_tex(data.frame(Check = c("Breusch-Pagan, simple / multiple model", "Standard errors (simple / multiple)",
"VIF of Adjusted Rating", "Shapiro-Wilk on residuals",
"Influential cafes (Cook's D > 4/n)", "Cafes lost to missing values"),
Result = c(paste0("p = ", pplain(bpa), " / ", pplain(bpb)),
paste(if (bpa < .05) "HC3" else "classical", "/", if (bpb < .05) "HC3" else "classical"),
f2(vif8), paste0("p = ", pplain(sw8)),
if (length(cd8)) paste(cd8, collapse = ", ") else "none", N - n8)), "A8_checks")
save_diag(m8b, "A8_diag")
cdf <- data.frame(model = factor(c("Without espresso price", "With espresso price"),
levels = c("Without espresso price", "With espresso price")),
est = c(before, after), lo = c(rta$lo["adj_rating"], rtb$lo["adj_rating"]),
hi = c(rta$hi["adj_rating"], rtb$hi["adj_rating"]))
fig <- ggplot(cdf, aes(model, est)) + geom_hline(yintercept = 0, linetype = "dashed") +
geom_pointrange(aes(ymin = lo, ymax = hi), colour = "red") +
labs(x = NULL, y = "Slope of Adjusted Rating (CZK per rating point)")
save_fig(fig, "A8_figure")
s8 <- paste0("$t(", rtb$df, ")=", f2(after / rtb$se["adj_rating"]), "$")
add_sum("A8", paste0("OLS, two predictors", if (bpb < .05) " (HC3 SE)" else ""),
paste0(f1(after), " CZK per point (was ", f1(before), "; ", f1(100 * after / before), "% remains)"),
ci_str(rtb$lo["adj_rating"], rtb$hi["adj_rating"], f1),
paste0("$R^2=", sub("^0", "", f2(summary(m8b)$r.squared)), "$"), s8, pfmt(rtb$p["adj_rating"]), n8, N - n8)
# ============================================================
# A9  Interaction: does the rating-price slope differ between roasteries and other cafes?
# H0: interaction coefficient = 0   H1: it differs from 0 (two-tailed)
# ============================================================
cat("\n\n=========== A9 ===========\n")
d9 <- d[!is.na(d$cappuccino) & !is.na(d$adj_rating) & !is.na(d$roastery_f), ]; n9 <- nrow(d9)
d9$grp <- relevel(d9$roastery_f, ref = "Other cafes")
cat("Roasteries in this analysis:", sum(d9$grp == "Roastery"), "of", n9, "\n")
m9 <- lm(cappuccino ~ adj_rating * grp, data = d9)
bp9 <- lmtest::bptest(m9)$p.value; rob9 <- bp9 < .05
vc9 <- if (rob9) sandwich::vcovHC(m9, type = "HC3") else vcov(m9)
rt9 <- reg_table(m9, vc9); sh(rt9$tab); write_tex(rt9$tab, "A9_table")
ni <- "adj_rating:grpRoastery"; dfr <- m9$df.residual; b <- coef(m9)
s_oth <- b["adj_rating"]; se_oth <- sqrt(vc9["adj_rating", "adj_rating"])
s_roa <- b["adj_rating"] + b[ni]
se_roa <- sqrt(vc9["adj_rating", "adj_rating"] + vc9[ni, ni] + 2 * vc9["adj_rating", ni])
h <- qt(.975, dfr)
SL <- data.frame(Group = c("Other cafes", "Roasteries"), `Slope (CZK per rating point)` = f1(c(s_oth, s_roa)),
`95% CI` = c(ci_str(s_oth - h * se_oth, s_oth + h * se_oth, f1),
ci_str(s_roa - h * se_roa, s_roa + h * se_roa, f1)), check.names = FALSE)
sh(SL); write_tex(SL, "A9_slopes")
sw9 <- shapiro.test(resid(m9))$p.value; cd9 <- inf_cooks(m9)
write_tex(data.frame(Check = c("Breusch-Pagan (constant variance)", "Standard errors", "Shapiro-Wilk on residuals",
"Influential cafes (Cook's D > 4/n)", "Roasteries in the sample",
"Cafes lost to missing values"),
Result = c(paste0("p = ", pplain(bp9)), if (rob9) "HC3 robust" else "classical", paste0("p = ", pplain(sw9)),
if (length(cd9)) paste(cd9, collapse = ", ") else "none", sum(d9$grp == "Roastery"), N - n9)), "A9_checks")
save_diag(m9, "A9_diag")
fig <- ggplot(d9, aes(adj_rating, cappuccino, colour = grp, fill = grp)) + geom_point(alpha = .6) +
geom_smooth(method = "lm", formula = y ~ x, alpha = .15) +
labs(x = "Adjusted Rating (points)", y = "Cappuccino price (CZK)", colour = NULL, fill = NULL)
save_fig(fig, "A9_figure")
int_est <- rt9$est[ni]
add_sum("A9", paste0("OLS with interaction", if (rob9) " (HC3 SE)" else ""),
paste0("Slope difference (roasteries minus others) ", f1(int_est), " CZK per point"),
ci_str(rt9$lo[ni], rt9$hi[ni], f1), paste0("$R^2=", sub("^0", "", f2(summary(m9)$r.squared)), "$"),
paste0("$t(", rt9$df, ")=", f2(int_est / rt9$se[ni]), "$"), pfmt(rt9$p[ni]), n9, N - n9)
# ============================================================
# A10  Logistic regression: flat white above the median vs Adjusted Rating
# H0: coefficient of Adjusted Rating (per 0.1) = 0   H1: > 0 (one-tailed, "more likely in better-rated cafes")
# ============================================================
cat("\n\n=========== A10 ===========\n")
d10 <- d[!is.na(d$above_med_flatwhite) & !is.na(d$adj_rating_tenth), ]; n10 <- nrow(d10)
m10 <- glm(above_med_flatwhite ~ adj_rating_tenth, data = d10, family = binomial)
cf <- summary(m10)$coefficients; b10 <- cf["adj_rating_tenth", 1]; se10 <- cf["adj_rating_tenth", 2]
z10 <- cf["adj_rating_tenth", 3]; p10 <- pnorm(z10, lower.tail = FALSE)        # one-tailed
or10 <- exp(b10 + c(-1, 1) * qnorm(.975) * se10)
# average marginal effect (percentage points per 0.1) with delta-method CI
ame_fun <- function(par) {
pp <- plogis(par[1] + par[2] * d10$adj_rating_tenth); mean(par[2] * pp * (1 - pp))
}
par_hat <- coef(m10); V <- vcov(m10); eps <- 1e-6
grad <- sapply(1:2, function(i) { hi <- par_hat; lo <- par_hat; hi[i] <- hi[i] + eps; lo[i] <- lo[i] - eps
(ame_fun(hi) - ame_fun(lo)) / (2 * eps) })
ame <- ame_fun(par_hat); se_ame <- sqrt(as.numeric(t(grad) %*% V %*% grad))
ame_ci <- 100 * (ame + c(-1, 1) * qnorm(.975) * se_ame)
A10 <- data.frame(`AME (pp per 0.1)` = f2(100 * ame), `95% CI` = ci_str(ame_ci[1], ame_ci[2]),
`Odds ratio` = f2(exp(b10)), `OR 95% CI` = ci_str(or10[1], or10[2]),
Test = paste0("$z=", f2(z10), "$"), p = paste(pfmt(p10), "(one-tailed)"), n = n10,
check.names = FALSE)
sh(A10); write_tex(A10, "A10_table")
m10q <- glm(above_med_flatwhite ~ adj_rating_tenth + I(adj_rating_tenth^2), data = d10, family = binomial)
lin_p <- anova(m10, m10q, test = "Chisq")[["Pr(>Chi)"]][2]
cd10 <- inf_cooks(m10); epv <- min(sum(d10$above_med_flatwhite), sum(1 - d10$above_med_flatwhite))
mcf <- 1 - as.numeric(logLik(m10) / logLik(update(m10, . ~ 1)))
write_tex(data.frame(Check = c("Linearity of the logit (LR test, quadratic term)", "Influential cafes (Cook's D > 4/n)",
"Cafes in the smaller outcome class", "McFadden pseudo-R2",
"Cafes lost to missing values"),
Result = c(paste0("p = ", pplain(lin_p)), if (length(cd10)) paste(cd10, collapse = ", ") else "none",
epv, f2(mcf), N - n10)), "A10_checks")
grid <- data.frame(adj_rating_tenth = seq(min(d10$adj_rating_tenth), max(d10$adj_rating_tenth), length.out = 100))
pr <- predict(m10, grid, type = "link", se.fit = TRUE)
grid$fit <- plogis(pr$fit); grid$lo <- plogis(pr$fit - 1.96 * pr$se.fit); grid$hi <- plogis(pr$fit + 1.96 * pr$se.fit)
grid$rating <- grid$adj_rating_tenth * 0.1; d10$rating <- d10$adj_rating_tenth * 0.1
fig <- ggplot() +
geom_jitter(data = d10, aes(rating, above_med_flatwhite), height = .03, alpha = .4) +
geom_ribbon(data = grid, aes(rating, ymin = lo, ymax = hi), alpha = .2, fill = "red") +
geom_line(data = grid, aes(rating, fit), colour = "red") +
labs(x = "Adjusted Rating (points)", y = "Probability that flat white price is above the median")
save_fig(fig, "A10_figure")
add_sum("A10", "Logit + average marginal effect", paste(f2(100 * ame), "pp per 0.1 rating point"),
ci_str(ame_ci[1], ame_ci[2]), paste0("OR $=", f2(exp(b10)), "$"), paste0("$z=", f2(z10), "$"),
pfmt(p10), n10, N - n10)
# ============================================================
# Summary table of the main results (S_table.tex)
# ============================================================
cat("\n\n=========== Summary of all analyses ===========\n")
options(width = 220); sh(SUM)
write_tex(SUM, "S_table", align = "lllllllrr")
cat("\nAll tables and figures saved in ../report/\n")
# ============================================================
# 01_cleaning.R  -  Prague cafe data: inspect, clean, create variables
# Input : raw_data.csv (raw Google-Sheet export, never edited by hand)
# Output: dataset.csv  (cleaned data, no row numbers)
# Base R only - no packages needed.
# ============================================================
# Run from the "analysis" folder (RStudio: Session > Set Working Directory > To Source File Location)
infile <- "raw_data.csv"                       # the raw CSV downloaded from Google Drive
if (!file.exists(infile) && file.exists("2__Data_Collection_Sheet_-_Sheet1.csv"))
infile <- "2__Data_Collection_Sheet_-_Sheet1.csv"
if (!file.exists(infile)) {
message("Raw CSV not found in the working folder - select it in the window.")
infile <- file.choose()
}
outfile <- "dataset.csv"                       # the only file later scripts read
# ---------- 1. INSPECT BEFORE CHANGING ANYTHING ----------
# (a) the types R guesses by default: a numeric column stored as text
#     (chr) means it contains non-numeric values
guess <- read.csv(infile, na.strings = c("", "NA"), check.names = FALSE)
cat("\n=== Structure with R's default types ===\n")
str(guess)
# (b) read everything as text so nothing is changed silently
raw <- read.csv(infile, colClasses = "character", na.strings = c("", "NA"),
check.names = FALSE, strip.white = TRUE)
cat("\nRows x columns in raw file:", nrow(raw), "x", ncol(raw), "\n")
# Short names, matched by the START OF EACH HEADER (not by position), so the
# script still works if the sheet gains or loses extra columns.
patterns <- c(name = "^Name$", visit_time = "^Date and time", district_num = "^District \\(number\\)",
district_name = "^District \\(name\\)", cafe = "^Cafe name", address = "^Cafe address",
coords = "^Coordinates", link = "^Link to GMaps", p_espresso = "^Espresso",
p_cappuccino = "^Cappuccino", p_flatwhite = "^Flat White", p_filter = "^Filter",
payment = "^Payment", seats_in = "^Seating Places Inside",
seats_out = "^Seating Places Outside", rating = "^Rating \\(Google\\)",
n_ratings = "^Number of ratings", cafe_type = "^Cafe Type", roastery = "^Is Roastery",
photo_folder = "^Photo Link", note = "^Note", auto_arrow = "^AUTOMATIC",
dist_orloj = "^Distance from", lat_sheet = "^Latitude", lon_sheet = "^Longitude")
idx <- sapply(patterns, function(pt) {
hit <- grep(pt, names(raw), ignore.case = TRUE)
if (length(hit) != 1) stop("Column not found exactly once for pattern: ", pt)
hit
})
# optional: the sheet's own Adjusted Rating column (used only to compare with ours)
adj_hit <- grep("^Adjusted Rating", names(raw), ignore.case = TRUE)
unused <- setdiff(seq_along(raw), c(idx, adj_hit))
if (length(unused)) cat("Columns not used:", paste(names(raw)[unused], collapse = " | "), "\n")
keep <- c(idx, if (length(adj_hit) == 1) adj_hit)
raw <- raw[, keep]
names(raw) <- c(names(patterns), if (length(adj_hit) == 1) "adj_sheet")
cat("\n=== Missing values per column (raw) ===\n")
print(colSums(is.na(raw)))
# Empty rows: no cafe name, coordinates or link. (Payment and the automatic
# columns are pre-filled in empty rows, so they are not used for this test.)
empty <- is.na(raw$cafe) & is.na(raw$coords) & is.na(raw$link)
cat("\nCompletely empty rows:", sum(empty), "\n")
cat("Exact duplicated rows (all columns):", sum(duplicated(raw)), "\n")
n_before <- nrow(raw)
df <- raw[!empty, ]
cat("Rows after dropping empty rows:", nrow(df), "\n")
# Duplicates: same cafe name AND address entered more than once?
key <- paste(tolower(df$cafe), tolower(df$address))
dup_key <- key %in% key[duplicated(key)]
cat("\n=== Rows sharing the same cafe name + address (inspect by eye) ===\n")
print(df[dup_key, c("name", "cafe", "address", "p_espresso", "p_cappuccino",
"rating", "n_ratings")])
# DECISION: these are the same physical cafe recorded by two people (same
# address, coordinates, rating, number of ratings), not two different cafes.
# Keep the first entry, drop the later one(s). Prices differ, so they are not
# exact duplicates - the first entry's prices are kept.
df <- df[!duplicated(key), ]
cat("Rows after removing repeated cafe entries:", nrow(df), "\n")
# ---------- 2. CATEGORIES ----------
cat("\n=== Raw categories ===\n")
for (v in c("district_num", "cafe_type", "payment", "roastery")) {
cat("\n", v, "\n"); print(table(df[[v]], useNA = "ifany"))
}
# District: lower-case/trim, then rebuild as "Prague <number>".
# Fixes "prague 1", "prauge 1", "Prage 7", trailing spaces.
df$district <- ifelse(is.na(df$district_num), NA,
paste("Prague", gsub("[^0-9]", "", df$district_num)))
# Cafe type: trim, standardise capitals; blank already read as NA
df$cafe_type_clean <- tools::toTitleCase(tolower(trimws(df$cafe_type)))
df$payment_clean   <- trimws(df$payment)
# Entries combining two categories? (look for separators other than the
# legitimate "Cash & Card")
combo <- grepl("[/,;]", df$cafe_type) | grepl("[/,;]", df$district_num) |
grepl("[/,;]", df$payment)
cat("\nRows with combined categories:", sum(combo), "\n")
cat("\n=== Cleaned categories (compare with raw above) ===\n")
for (v in c("district", "cafe_type_clean", "payment_clean")) {
cat("\n", v, "\n"); print(table(df[[v]], useNA = "ifany"))
}
# ---------- 3. PRICES ----------
# Show every price cell that is not a plain number
price_cols <- c("p_espresso", "p_cappuccino", "p_flatwhite", "p_filter")
cat("\n=== Price cells that are not a single number ===\n")
for (v in price_cols) {
bad <- unique(df[[v]][!is.na(df[[v]]) & !grepl("^[0-9]+(\\.[0-9]+)?$", df[[v]])])
cat(v, ":", paste(bad, collapse = " | "), "\n")
}
# DECISION: several prices ("85, 95, 105", "65/40", "45,60") -> take the FIRST
# listed value (default rule from the directions). The text "na" -> NA.
first_price <- function(x) {
x <- trimws(x)
out <- suppressWarnings(as.numeric(sub("^([0-9]+(\\.[0-9]+)?).*$", "\\1", x)))
out[!grepl("^[0-9]", x)] <- NA
out
}
df$espresso   <- first_price(df$p_espresso)
df$cappuccino <- first_price(df$p_cappuccino)
df$flatwhite  <- first_price(df$p_flatwhite)
df$filter     <- first_price(df$p_filter)
cat("\nCheck (original vs converted), rows that had multiple prices:\n")
for (v in price_cols) {
nm <- sub("p_", "", v); nm <- c(espresso="espresso", cappuccino="cappuccino",
flatwhite="flatwhite", filter="filter")[nm]
i <- which(!is.na(df[[v]]) & !grepl("^[0-9]+(\\.[0-9]+)?$", df[[v]]))
if (length(i)) print(head(data.frame(original = df[[v]][i], kept = df[[nm]][i]), 8))
}
# DECISION: an NA filter price means the cafe does not serve filter coffee.
# The price stays NA (never 0); a separate 0/1 indicator records the offer.
df$serves_filter <- ifelse(is.na(df$filter), 0, 1)
# ---------- 4. TEXT -> NUMBERS ----------
num_cols <- c("seats_in", "seats_out", "rating", "n_ratings", "roastery")
cat("\n=== Values containing anything other than digits and a decimal point ===\n")
for (v in num_cols) {
bad <- unique(df[[v]][!is.na(df[[v]]) & !grepl("^[0-9]+(\\.[0-9]+)?$", df[[v]])])
cat(v, ":", if (length(bad)) paste(bad, collapse = " | ") else "none", "\n")
}
# Problem confirmed: number of ratings has thousands separators ("1,020").
# Make sure the ONLY issue is a comma used as thousands separator before removing it.
bad_n <- df$n_ratings[!is.na(df$n_ratings) & !grepl("^[0-9]+$", df$n_ratings)]
stopifnot(all(grepl("^[0-9]{1,3}(,[0-9]{3})+$", bad_n)))
df$n_ratings_num <- as.numeric(gsub(",", "", df$n_ratings))
df$rating_num    <- as.numeric(df$rating)
df$seats_in_num  <- as.numeric(df$seats_in)
df$seats_out_num <- as.numeric(df$seats_out)
df$roastery_num  <- as.numeric(df$roastery)
cat("\nVisual check of the conversion (original text vs number):\n")
chk <- which(df$n_ratings %in% bad_n)
print(data.frame(original = df$n_ratings[chk], converted = df$n_ratings_num[chk]))
stopifnot(all(is.na(df$n_ratings) == is.na(df$n_ratings_num)))   # no NA created
# Visit time (mixed formats "9/22/2026" and "9/22/26") - kept for reference
vt <- trimws(df$visit_time)
df$visit_time_clean <- as.POSIXct(rep(NA_character_, length(vt)), tz = "Europe/Prague")
short <- grepl("^[0-9]+/[0-9]+/[0-9]{2} ", vt)
long  <- grepl("^[0-9]+/[0-9]+/[0-9]{4} ", vt)
df$visit_time_clean[long]  <- as.POSIXct(vt[long],  format = "%m/%d/%Y %H:%M:%S", tz = "Europe/Prague")
df$visit_time_clean[short] <- as.POSIXct(vt[short], format = "%m/%d/%y %H:%M:%S", tz = "Europe/Prague")
# ---------- 5. NEW VARIABLES ----------
# Coordinates: split "50.073..., 14.438..." into latitude and longitude
parts <- strsplit(df$coords, ",")
df$latitude  <- as.numeric(sapply(parts, function(p) trimws(p[1])))
df$longitude <- as.numeric(sapply(parts, function(p) trimws(p[2])))
cat("\nMax difference vs the sheet's own Latitude/Longitude columns:",
max(abs(df$latitude - as.numeric(df$lat_sheet)), na.rm = TRUE), "/",
max(abs(df$longitude - as.numeric(df$lon_sheet)), na.rm = TRUE), "\n")
# Distances from the Orloj (50.0871 N, 14.4207 E); 1 deg lat = 111 km, 1 deg lon = 71 km
df$ns_km <- (df$latitude  - 50.0871) * 111      # + = north of the Orloj
df$ew_km <- (df$longitude - 14.4207) * 71       # + = east of the Orloj
df$abs_ns_km <- abs(df$ns_km)                   # for question A3
df$abs_ew_km <- abs(df$ew_km)
# Adjusted Rating (shrinkage): (n*R + 50*C) / (n + 50)
# C = mean raw rating of all cafes (computed in code, not typed in)
C <- mean(df$rating_num, na.rm = TRUE)
cat("C (mean rating of all cafes) =", C, "\n")
df$adj_rating <- (df$n_ratings_num * df$rating_num + 50 * C) / (df$n_ratings_num + 50)
if ("adj_sheet" %in% names(df)) {
cat("Max difference between my Adjusted Rating and the sheet's own column:",
max(abs(df$adj_rating - suppressWarnings(as.numeric(df$adj_sheet))), na.rm = TRUE), "\n")
}
# Price Level: mean of espresso, cappuccino, flat white - ONLY cafes with all three
all3 <- !is.na(df$espresso) & !is.na(df$cappuccino) & !is.na(df$flatwhite)
df$price_level <- ifelse(all3, (df$espresso + df$cappuccino + df$flatwhite) / 3, NA)
# Indicators (0/1; NA stays NA)
df$prague1       <- ifelse(is.na(df$district), NA, as.numeric(df$district == "Prague 1"))
df$outdoor       <- ifelse(is.na(df$seats_out_num), NA, as.numeric(df$seats_out_num > 0))
df$above_med_adj <- ifelse(is.na(df$adj_rating), NA,
as.numeric(df$adj_rating > median(df$adj_rating, na.rm = TRUE)))
df$above_med_price <- ifelse(is.na(df$price_level), NA,
as.numeric(df$price_level > median(df$price_level, na.rm = TRUE)))
df$above_med_nrat  <- ifelse(is.na(df$n_ratings_num), NA,
as.numeric(df$n_ratings_num > median(df$n_ratings_num, na.rm = TRUE)))
# Q5 / Q10: flat white price above the median flat white price (median computed in code)
med_fw <- median(df$flatwhite, na.rm = TRUE)
df$above_med_flatwhite <- ifelse(is.na(df$flatwhite), NA, as.numeric(df$flatwhite > med_fw))
cat("Median flat white price used for the indicator:", med_fw, "CZK\n")
# Q3 (paired): flat white minus cappuccino, only where BOTH prices exist
df$fw_minus_cap <- ifelse(!is.na(df$flatwhite) & !is.na(df$cappuccino),
df$flatwhite - df$cappuccino, NA)
# Q10: Adjusted Rating in steps of 0.1 (so a logit/marginal effect is "per 0.1")
df$adj_rating_tenth <- df$adj_rating / 0.1
cat("Medians used: adj_rating =", median(df$adj_rating, na.rm = TRUE),
"| price_level =", median(df$price_level, na.rm = TRUE),
"| n_ratings =", median(df$n_ratings_num, na.rm = TRUE), "\n")
# ---------- 6. FINAL DATA SET (originals kept next to clean versions) ----------
clean <- data.frame(
name = df$name, visit_time = df$visit_time_clean, cafe = df$cafe,
address = df$address,
district_orig = df$district_num, district = df$district, prague1 = df$prague1,
cafe_type_orig = df$cafe_type, cafe_type = df$cafe_type_clean,
payment = df$payment_clean,
espresso_orig = df$p_espresso, espresso = df$espresso,
cappuccino_orig = df$p_cappuccino, cappuccino = df$cappuccino,
flatwhite_orig = df$p_flatwhite, flatwhite = df$flatwhite,
filter_orig = df$p_filter, filter = df$filter, serves_filter = df$serves_filter,
price_level = df$price_level, above_med_price = df$above_med_price,
seats_in = df$seats_in_num, seats_out = df$seats_out_num, outdoor = df$outdoor,
rating = df$rating_num, n_ratings_orig = df$n_ratings,
n_ratings = df$n_ratings_num, adj_rating = df$adj_rating,
above_med_flatwhite = df$above_med_flatwhite, fw_minus_cap = df$fw_minus_cap,
adj_rating_tenth = df$adj_rating_tenth,
above_med_adj = df$above_med_adj, above_med_nrat = df$above_med_nrat,
roastery = df$roastery_num,
dist_orloj_sheet = as.numeric(df$dist_orloj),
latitude = df$latitude, longitude = df$longitude,
ns_km = df$ns_km, ew_km = df$ew_km, abs_ns_km = df$abs_ns_km, abs_ew_km = df$abs_ew_km,
stringsAsFactors = FALSE
)
# ---------- 7. CHECK THE RESULT ----------
cat("\n=== Final checks ===\n")
cat("Rows: raw file", n_before, "-> cleaned", nrow(clean), "\n")
cat("\nMissing values per column (cleaned):\n"); print(colSums(is.na(clean)))
cat("\nRanges of the variables used:\n")
rng <- c("espresso", "cappuccino", "flatwhite", "filter", "price_level", "seats_in",
"seats_out", "rating", "n_ratings", "adj_rating", "roastery",
"ns_km", "ew_km")
print(t(sapply(clean[rng], function(x) range(x, na.rm = TRUE))))
stopifnot(all(clean$rating >= 1 & clean$rating <= 5, na.rm = TRUE),
all(clean$adj_rating >= 1 & clean$adj_rating <= 5, na.rm = TRUE),
all(clean$price_level > 0, na.rm = TRUE),
all(clean$n_ratings >= 0, na.rm = TRUE))
cat("\nSanity check, ew_km/ns_km vs the sheet's own distance (should be close):\n")
print(head(data.frame(sheet = clean$dist_orloj_sheet,
mine = sqrt(clean$ns_km^2 + clean$ew_km^2)), 5))
write.csv(clean, outfile, row.names = FALSE)
cat("\nSaved", outfile, "with", nrow(clean), "rows and", ncol(clean), "columns\n")
